# vpn-master 开发 env 模板 (cp 为 deploy/.env, 勿提交真实值)
# ---- postgres ----
POSTGRES_USER=vpnmaster
POSTGRES_PASSWORD=change-me-dev
# ---- marzban (键名以 marzban 官方 .env 模板为准, setup 时校对) ----
# MARZBAN_SECRET_KEY=
# MARZBAN_JWT_SECRET_KEY=
# MARZBAN_PANEL_DOMAIN=panel.localhost:8080
# POSTGRES_HOST=postgres
# ---- ingest: 上游订阅 URL (含 token, 只在 env/Dokploy secrets 管理, 永不进代码库) ----
# 示例格式: https://<your-upstream>/sub?token=<XXXX>
# 注意: 已知的两条 sub (rexleimo / vpn-4zx) 实为同一上游源, 且 uuid 不同(可能分属两个独立订阅账号)
# MVP 只启用一条, 避免双拉; 后续引入真正独立的第二个上游再开 SUB_UPSTREAM_2
SUB_UPSTREAM_1_URL=
# SUB_UPSTREAM_2_URL=
INGEST_POLL_INTERVAL=5m
# ---- ingest: 探测/剔除参数 ----
PROBE_INTERVAL=30s
EVICT_FAILS=3
RECOVER_SUCCESSES=2

# ---- user-center: 账号系统 (open-rails/authkit + PostgreSQL) ----
# 专用库 rexvpn (compose 首启由 deploy/init 自动建; brew PG 手工建库见 docs/deploy-subscription.md)
UC_PG_DSN=postgres://vpnmaster:change-me-dev@localhost:5432/rexvpn?sslmode=disable
UC_TENANT_ID=            # 任意稳定 UUID(authkit 租户), 生成: uuidgen
UC_ISSUER=rex-vpn        # token 签发者标识
UC_KEYS_PATH=            # 留空默认 ~/.local/state/rex-vpn/keys (自动生成, 0600, 勿提交)
UC_ADMIN_EMAIL=          # 种子管理员(启动时 ensure, 密码建议 12+ 字符且不含邮箱片段)
UC_ADMIN_PASSWORD=
USERCENTER_SECURE_COOKIES=   # HTTPS 反代后置 "1"

# ---- user-center: 订阅计费 (Waffo Pancake, 见 docs/deploy-subscription.md) ----
# 本地开发: WAFFO_STUB=1 + UC_MARZBAN_STUB=1 即可全链路演练, 无需凭证
# WAFFO_STUB=1
WAFFO_ENV=test               # test | production
WAFFO_MERCHANT_ID=           # 商户号
WAFFO_STORE_ID=              # 店铺 ID(可选)
WAFFO_PRIVATE_KEY=           # RSA 私钥(PEM 原文或文件路径, 见 waffo-kit)
WAFFO_PUBLIC_BASE=           # 对外基址, 例 https://user.example.com (checkout 回跳/webhook 相对地址用)
WAFFO_CURRENCY=CNY
WAFFO_WEBHOOK_PUBLIC_KEY=    # 平台 webhook 验签公钥(留空则用 SDK 内置)
# 套餐(与 Waffo 商品映射): 名称/分/流量GiB/天数, 逗号分隔多条
# USERCENTER_PLANS=轻量 10GB/月:990:10:30,标准 50GB/月:3990:50:30,畅享 200GB/月:11990:200:30

# ---- user-center: Marzban 开通 (购买后自动建用户) ----
MARZBAN_API_BASE=http://localhost:8080
MARZBAN_ADMIN_USER=
MARZBAN_ADMIN_PASSWORD=
MARZBAN_INBOUND_IDS=         # 逗号分隔的 inbound id, 新用户默认挂载
UC_MARZBAN_STUB=             # 1=内存 mock(仅本地开发/E2E)
