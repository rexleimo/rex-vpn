# vpn-master 开发 env 模板 (cp 为 deploy/.env, 勿提交真实值)
# ---- postgres ----
POSTGRES_USER=vpnmaster
POSTGRES_PASSWORD=change-me-dev
# ---- marzban (键名以 marzban 官方 .env 模板为准, setup 时校对) ----
# MARZBAN_SECRET_KEY=
# MARZBAN_JWT_SECRET_KEY=
# MARZBAN_PANEL_DOMAIN=panel.localhost:8080
# POSTGRES_HOST=postgres
# ---- ingest: 上游订阅 URL (含 token, 只在 env/Dokploy secrets 管理, 永不进代码库) ----
# 示例格式: https://<your-upstream>/sub?token=<XXXX>
# 注意: 已知的两条 sub (rexleimo / vpn-4zx) 实为同一上游源, 且 uuid 不同(可能分属两个独立订阅账号)
# MVP 只启用一条, 避免双拉; 后续引入真正独立的第二个上游再开 SUB_UPSTREAM_2
SUB_UPSTREAM_1_URL=
# SUB_UPSTREAM_2_URL=
INGEST_POLL_INTERVAL=5m
# ---- ingest: 探测/剔除参数 ----
PROBE_INTERVAL=30s
EVICT_FAILS=3
RECOVER_SUCCESSES=2
