# vpn-master / ingest (开发镜像: air 热重载, 源码由 dev compose 挂载到 /src, 共享模块挂 /webui)
# build context = 仓库 services/ 目录。
FROM golang:1.26-alpine
ENV GOPROXY=https://goproxy.cn,direct
RUN go install github.com/air-verse/air@latest
WORKDIR /src
COPY ingest/.air.toml .air.toml
# 预拉模块缓存, 减少热重载首编耗时
COPY webui/go.mod ./webui/go.mod
COPY ingest/go.mod ./ingest/go.mod
COPY ingest/go.sum ./ingest/go.sum
RUN cd ingest && go mod download || true
CMD ["air"]
